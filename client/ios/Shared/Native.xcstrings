    "widgetSampleVerse" : {
      "comment" : "Sample content in the widget gallery's preview, not real data. A Bible verse (Psalm 46:10): use the usual wording of a common translation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seid stille und erkennet, dass ich Gott bin!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be still, and know that I am God."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estad quietos, y conoced que yo soy Dios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez, et sachez que je suis Dieu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamlah dan ketahuilah, bahwa Akulah Allah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermatevi e riconoscete che io sono Dio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静まって、わたしこそ神であることを知れ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너희는 가만히 있어 내가 하나님 됨을 알지어다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquietai-vos e sabei que eu sou Deus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durun ve Tanrı olduğumu bilin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy yên lặng và biết rằng Ta là Đức Chúa Trời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们要休息，要知道我是神。"
