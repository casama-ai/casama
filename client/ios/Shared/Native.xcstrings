    "widgetIosInlineDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. The one-line Lock Screen widget.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
