    "widgetIosAskDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Ask, iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage einen Bot oder starte mit einem Tippen einen Anruf – mit Ideen zum Ausprobieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask a bot or start a call with one tap, with ideas to try."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta a un bot o inicia una llamada con un toque, con ideas para probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander à un bot ou lancer un appel en un toucher, avec des idées à essayer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya bot atau mulai panggilan dengan satu ketukan, beserta ide untuk dicoba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a un bot o avvia una chiamata con un tocco, con idee da provare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワンタップでボットに質問や通話を開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 한 번으로 봇에게 질문하거나 통화를 시작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte a um bot ou inicie uma chamada com um toque, com ideias para testar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denenecek fikirlerle birlikte tek dokunuşla bir bota sorun veya sesli arama başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi bot hoặc bắt đầu cuộc gọi chỉ với một chạm, kèm gợi ý dùng thử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一下即可向机器人提问或发起语音通话，还附带实用示例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下即可向機器人提問或開始通話，還有推薦點子可試用。"
          }
        }
      }
    },
    "widgetIosBotDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Bot, iPhone and Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte im Blick, was einer deiner Bots gerade tut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep an eye on what one of your bots is doing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue de cerca lo que está haciendo uno de tus bots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder un œil sur ce que fait l'un de vos bots."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau terus apa yang sedang dilakukan salah satu botmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni d’occhio cosa sta facendo uno dei tuoi bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボットの作業状況をいつでも確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "봇이 지금 무엇을 하고 있는지 살펴봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o que um dos seus bots está fazendo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlarınızdan birinin ne yaptığını takip edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi việc một bot của bạn đang làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时留意你的其中一个机器人正在做什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨時掌握其中一個機器人目前的運作動態。"
          }
        }
      }
    },
    "widgetIosBriefDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Brief, iPhone and Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies, was dir dein Bot heute Morgen berichtet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read what your bot told you this morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee lo que tu bot te contó esta mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire ce que votre bot vous a dit ce matin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca apa yang disampaikan botmu pagi ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi ciò che il tuo bot ti ha riferito stamattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今朝ボットから届いた内容を読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 아침 봇이 보내 준 내용을 읽어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia o que seu bot contou nesta manhã."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botunuzun bu sabah size söylediklerini okuyun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc bản tin bot gửi cho bạn sáng nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阅读机器人在今天早上为你整理的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閱讀機器人今天早上為你整理的訊息。"
          }
        }
      }
    },
    "widgetIosCanvasDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Canvas, iPhone and Mac. A verse is a line of scripture or poetry.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, was deine Bots hier ablegen: einen Vers, einen Countdown, eine Serie, eine Liste oder ein Bild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show what your bots put here: a verse, a countdown, a streak, a list or a picture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra lo que ponen ahí tus bots: un versículo, una cuenta regresiva, una racha, una lista o una imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher ce que vos bots y placent : un verset, un compte à rebours, une série, une liste ou une image."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan apa yang dipasang botmu di sini: kutipan ayat, hitung mundur, rekor beruntun, daftar, atau gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra ciò che i tuoi bot mettono qui: una frase, un conto alla rovescia, una serie, un elenco o un’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名言、カウントダウン、連続記録、リスト、画像などボットが置いたものを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 말씀, 카운트다운, 연속 기록, 목록, 사진 등 봇이 올려둔 내용을 표시해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre o que seus bots colocaram aqui: um versículo, uma contagem regressiva, uma sequência, uma lista ou uma imagem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlarınızın buraya koyduklarını gösterin: bir dize, geri sayım, seri, liste veya resim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị nội dung bot đặt lên đây: câu trích dẫn, đếm ngược, chuỗi ngày, danh sách hoặc hình ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展示机器人放置在这里的内容：一句经文或诗句、倒计时、连续记录、列表或图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示機器人放在這裡的內容：每日金句、倒數計時、連續紀錄、清單或圖片。"
          }
        }
      }
    },
    "widgetIosCreditsDescription" : {
