    "widgetSampleBotText" : {
      "comment" : "Sample content in the widget gallery's preview, not real data. A bot's last message. Acme is a made-up company.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei E-Mails warten auf eine Antwort, und die Acme-Rechnung ist zwei Tage überfällig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three emails need a reply, and the Acme invoice is two days overdue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres correos necesitan respuesta y la factura de Acme tiene dos días de vencida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois e-mails attendent une réponse et la facture Acme a deux jours de retard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga email perlu dibalas, dan faktur Acme sudah lewat dua hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre email attendono risposta e la fattura Acme è scaduta da due giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3通のメールに返信が必要で、Acme社の請求書が期限を2日過ぎています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 3건에 답장이 필요하고, Acme 청구서 기한이 이틀 지났어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três e-mails precisam de resposta, e a fatura da Acme está dois dias atrasada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç e-posta yanıt bekliyor ve Acme faturası iki gün gecikmiş."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có ba email cần trả lời, và hóa đơn Acme đã quá hạn hai ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有三封邮件需要回复，另外 Acme 的发票已逾期两天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有三封電子郵件需要回覆，而且 Acme 的帳單已逾期兩天。"
          }
        }
      }
    },
    "widgetSampleBrief" : {
      "comment" : "Sample content in the widget gallery's preview, not real data. A morning brief. Acme is a made-up company, Dana a person.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei E-Mails warten auf eine Antwort, und die Acme-Rechnung ist zwei Tage überfällig. Ab 15 Uhr Regen, also fahr frühzeitig zur Abholung um 16:30 Uhr los. Dein erstes Meeting ist um 10:00 Uhr mit Dana."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three emails need a reply, and the Acme invoice is two days overdue. Rain from 3 pm, so leave early for the 4:30 pickup. Your first meeting is at 10:00 with Dana."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres correos necesitan respuesta y la factura de Acme tiene dos días de vencida. Lluvia desde las 15:00, así que sal temprano para recoger a las 16:30. Tu primera reunión es a las 10:00 con Dana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois e-mails attendent une réponse et la facture Acme a deux jours de retard. Pluie à partir de 15 h, partez tôt pour le rendez-vous de 16 h 30. Votre première réunion est à 10 h 00 avec Dana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga email perlu dibalas, dan faktur Acme sudah lewat dua hari. Hujan mulai pukul 15.00, jadi berangkat lebih awal untuk jemputan pukul 16.30. Rapat pertamamu pukul 10.00 dengan Dana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre email attendono risposta e la fattura Acme è scaduta da due giorni. Pioggia dalle 15:00, quindi esci presto per il ritiro delle 16:30. La prima riunione è alle 10:00 con Dana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3通のメールに返信が必要で、Acme社の請求書が期限を2日過ぎています。15時から雨のため、16:30のお迎えには早めに出てください。最初の会議は10:00にDanaとあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 3건에 답장이 필요하고, Acme 청구서 기한이 이틀 지났어요. 오후 3시부터 비 예보가 있으니 4시 30분 픽업에 맞춰 일찍 출발하세요. 첫 회의는 오전 10시 Dana와 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três e-mails precisam de resposta, e a fatura da Acme está dois dias atrasada. Chuva a partir das 15:00, então saia cedo para buscar às 16:30. Sua primeira reunião é às 10:00 com Dana."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç e-posta yanıt bekliyor ve Acme faturası iki gün gecikmiş. Saat 15:00'ten itibaren yağmur var, bu yüzden 16:30'daki alma işlemi için erken çıkın. İlk toplantınız saat 10:00'da Dana ile."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có ba email cần trả lời, và hóa đơn Acme đã quá hạn hai ngày. Trời mưa từ 15:00 nên hãy đi sớm đón lúc 16:30. Cuộc họp đầu tiên của bạn lúc 10:00 với Dana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有三封邮件需要回复，另外 Acme 的发票已逾期两天。下午 3 点起有雨，4:30 去接人请提前出门。你的第一场会议在 10:00，对象是 Dana。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有三封電子郵件需要回覆，而且 Acme 的帳單已逾期兩天。下午 3 點起會下雨，4 點半接小孩請提早出門。今天第一場會議是在 10:00 與 Dana 開會。"
          }
        }
      }
    },
