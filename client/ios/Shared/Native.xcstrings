    "siriFocusDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Focus filter description. Focus is Apple's feature name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur ausgewählte Bots und hält proaktive Meldungen optional zurück, solange dieser Fokus aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show only chosen bots and optionally hold proactive check-ins while this Focus is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo los bots elegidos y, opcionalmente, retiene los avisos proactivos mientras este Enfoque esté activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'afficher que les bots choisis et mettre éventuellement en pause les points réguliers proactifs tant que ce mode de concentration est actif."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya tampilkan bot yang dipilih dan opsional tahan sapaan proaktif saat Fokus ini aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra solo i bot scelti e, se vuoi, trattieni gli aggiornamenti proattivi mentre Full immersion è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この集中モードがオンの間、選んだボットだけを表示し、必要に応じてボットからの自発的な声かけを保留します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 집중 모드가 켜진 동안 선택한 봇만 표시하고 선택적으로 먼저 말 걸기를 보류해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra apenas os bots escolhidos e, se quiser, segura avisos proativos enquanto este Foco estiver ativo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Odak etkinken yalnızca seçilen botları gösterin ve isteğe bağlı olarak proaktif bilgilendirmeleri bekletin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ hiện các bot được chọn và tùy chọn tạm giữ tin chủ động khi chế độ Tập trung này đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用此专注模式时，仅显示所选机器人，并可选择暂停机器人的主动消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用此專注模式時，僅顯示選取的機器人，並可選擇性暫緩主動訊息。"
          }
        }
      }
    },
