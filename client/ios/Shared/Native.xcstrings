    "siriWhatNeedsMeDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Action description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt, wie viele Dinge in Casama auf dich warten: die Bitte eines Bots um dein OK, eine Übernahme oder ein Vorschlag. Beantworte sie in der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Says how many things in Casama are waiting for you: a bot's request for your OK, a takeover, a suggestion. Answer them in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice cuántas cosas te están esperando en Casama: la solicitud de un bot para tu confirmación, una toma de control o una sugerencia. Respóndelas en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique combien d'éléments dans Casama vous attendent : une demande d'accord d'un bot, une prise de contrôle, une suggestion. Répondez-y dans l'app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu berapa banyak hal di Casama yang menunggumu: permintaan bot untuk OK-mu, ambil alih, saran. Jawab di aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice quante cose in Casama ti stanno aspettando: una richiesta di conferma di un bot, un passaggio di controllo o un suggerimento. Rispondi nell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casamaであなたを待っている承認、操作交代、提案の件数を知らせます。応答はアプリで行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama에서 나를 기다리는 항목 수를 알려 줘요. 봇의 승인 요청, 직접 조작 요청, 제안이 포함되며 앱에서 응답할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diz quantas coisas no Casama estão esperando você: um pedido de OK de um bot, um controle manual ou uma sugestão. Responda no app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama'da sizden yanıt bekleyen kaç şey olduğunu söyler: bir botun onay isteği, bir devralma veya bir öneri. Bunları uygulamada yanıtlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho biết có bao nhiêu việc trong Casama đang chờ bạn: yêu cầu phê duyệt, tiếp quản hay gợi ý từ bot. Hãy xử lý trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播报 Casama 中有多少待你处理的事项，包括机器人的确认请求、接管请求和建议。请在应用内回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明 Casama 中有多少事項正在等你處理：機器人的核准請求、接管請求或建議。請前往應用程式回覆。"
          }
        }
      }
    },
