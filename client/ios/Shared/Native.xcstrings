    "siriRunRoutineControlDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Action description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
