    "nativeSafariSignInIos" : {
      "comment" : "Safari extension on iPhone, shown when it can't sign in by itself. Keep the arrows; use the app's own names for Settings and Sign In on Another Device.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Casama auf diesem Gerät -> Einstellungen -> Auf anderem Gerät anmelden, oder füge unten einen Anmelde-Link ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Casama on this device -> Settings -> Sign In on Another Device, or paste a sign-in link below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Casama en este dispositivo -> Ajustes -> Iniciar sesión en otro dispositivo, o pega abajo un enlace de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Casama sur cet appareil -> Réglages -> Se connecter sur un autre appareil, ou collez un lien de connexion ci-dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Casama di perangkat ini -> Pengaturan -> Masuk di Perangkat Lain, atau tempel tautan masuk di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Casama su questo dispositivo -> Impostazioni -> Accedi su un altro dispositivo, oppure incolla qui sotto un link di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのCasamaで 設定 -> 別のデバイスでサインイン を開くか、下にサインインリンクを貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 Casama 열기 -> 설정 -> 다른 기기에서 로그인으로 이동하거나 아래에 로그인 링크를 붙여넣으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Casama neste dispositivo -> Configurações -> Entrar em Outro Dispositivo, ou cole um link de login abaixo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda Casama'yı açın -> Ayarlar -> Başka Bir Cihazda Oturum Aç bölümüne gidin veya aşağıya bir oturum açma bağlantısı yapıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở Casama trên thiết bị này -> Cài đặt -> Đăng nhập trên thiết bị khác, hoặc dán liên kết đăng nhập bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此设备上打开 Casama -> 设置 -> 在其他设备上登录，或在下方粘贴登录链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在此裝置開啟 Casama -> 設定 -> 在其他裝置登入，或在下方貼上登入連結。"
          }
        }
      }
    },
