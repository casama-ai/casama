    "siriAskBotDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Action description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine Frage an einen deiner Casama-Bots (KI-Assistenten) in einem neuen Chat und liest die Antwort vor. Ist kein Bot genannt, antwortet der Bot, mit dem du zuletzt gesprochen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends a question to one of your Casama bots (AI assistants) in a new chat and reads the reply back. With no bot named, the bot you talked to last answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una pregunta a uno de tus bots de Casama (asistentes de IA) en un chat nuevo y lee la respuesta. Si no nombras un bot, responde el último con el que hablaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une question à l'un de vos bots Casama dans une nouvelle discussion et lit la réponse à voix haute. Si aucun bot n'est nommé, le dernier bot avec lequel vous avez discuté répond."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim pertanyaan ke salah satu bot Casama-mu (asisten AI) di chat baru dan membacakan balasannya. Jika bot tidak disebutkan, bot yang terakhir kamu ajak bicara yang menjawab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia una domanda a uno dei tuoi bot Casama (assistenti IA) in una nuova chat e legge la risposta. Se non nomini alcun bot, risponde quello con cui hai parlato per ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casamaボットに新しいチャットで質問を送り、返答を読み上げます。ボットを指定しない場合は最後に話したボットが答えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 채팅에서 Casama 봇(AI 어시스턴트)에게 질문을 보내고 답변을 읽어 줘요. 봇 이름을 말하지 않으면 가장 최근에 대화한 봇이 답해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia uma pergunta para um dos seus bots do Casama (assistentes de IA) em um novo chat e lê a resposta. Sem um bot escolhido, quem responde é o último bot com quem você falou."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir sohbette Casama botlarınızdan (yapay zeka asistanlarından) birine soru gönderir ve yanıtı sesli okur. Bot adı verilmezse en son konuştuğunuz bot yanıtlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi câu hỏi tới một trong các bot Casama (trợ lý AI) trong cuộc trò chuyện mới và đọc lại câu trả lời. Nếu không nêu tên bot, bot bạn vừa trò chuyện gần nhất sẽ trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新聊天中向你的某个 Casama 机器人（AI 助手）提问并朗读回复。如果未指定机器人，则由你上次聊过的机器人回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新的對話中傳送問題給你的其中一個 Casama 機器人（AI 助理）並朗讀回覆。若未指定機器人，則由你上次對話的機器人回答。"
          }
        }
      }
    },
    "siriAskBotParamDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Parameter description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Bot gefragt werden soll. Leer lassen für den Bot, mit dem du zuletzt gesprochen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which bot to ask. Leave empty for the bot you talked to last."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A qué bot preguntar. Déjalo vacío para el último con el que hablaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel bot interroger. Laissez vide pour le dernier bot avec lequel vous avez discuté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot mana yang ditanya. Kosongkan untuk bot yang terakhir kamu ajak bicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quale bot chiedere. Lascia vuoto per il bot con cui hai parlato per ultimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのボットに質問するか指定します。空欄の場合は最後に話したボットになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문할 봇이에요. 비워 두면 가장 최근에 대화한 봇에게 물어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A qual bot perguntar. Deixe vazio para o último bot com quem você falou."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangi bota sorulacağı. En son konuştuğunuz bot için boş bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi bot nào. Để trống để chọn bot bạn vừa trò chuyện gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要向哪个机器人提问。留空则会询问你上次对话的机器人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要詢問哪個機器人。留空代表由上次對話的機器人回答。"
