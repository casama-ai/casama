    "siriToolNeedsDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Siri AI tool description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, wie viele Freigaben, Übernahmen oder Vorschläge in Casama warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check how many approvals, takeovers or suggestions are waiting in Casama."
