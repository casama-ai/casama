        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba cuántas aprobaciones, tomas de control o sugerencias están esperando en Casama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
