    "widgetIosTodayDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Today, iPhone and Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tag an einem Ort: Was dich braucht, was als Nächstes läuft und deine Credits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get your day in one place: what needs you, what runs next, and your credits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu día en un solo lugar: lo que requiere tu atención, lo que sigue y tus créditos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouver votre journée au même endroit : ce qui vous attend, les prochaines exécutions et vos crédits."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat harimu di satu tempat: yang perlu kamu tangani, yang berjalan berikutnya, dan kreditmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua giornata a colpo d’occhio: cosa richiede il tuo intervento, cosa è in programma e i tuoi crediti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認待ち、次の予定、クレジットを1か所で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인이 필요한 항목, 다음 일정, 크레딧까지 오늘 하루를 한곳에 모아 봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja seu dia em um só lugar: o que precisa de você, o que roda a seguir e seus créditos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gününüzü tek bir yerde görün: sizden ne beklendiği, sırada ne olduğu ve kredileriniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem trọn vẹn ngày của bạn ở một nơi: việc cần bạn, lịch chạy tiếp theo và tín dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一处掌握今日动态：待你处理的事项、接下来的任务以及你的额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一處掌握今日大小事：待你處理、接下來排程與剩餘額度。"
          }
        }
      }
    },
