    },
    "siriRunRoutineDescription" : {
      "comment" : "Siri, Shortcuts and App Intents on Apple devices. Action description.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt eine Routine deiner Casama-Bots sofort aus. Das Ergebnis erscheint in der App und als Benachrichtigung – genau wie bei einem automatischen Durchlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs one of your Casama bots' routines now. The result arrives in the app and as a notification, as it does when the routine runs on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta ahora una de las rutinas de tus bots de Casama. El resultado llega en la app y como notificación, igual que cuando la rutina se ejecuta sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute l'une des routines de vos bots Casama maintenant. Le résultat arrive dans l'app et par notification, comme lorsque la routine s'exécute d'elle-même."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan salah satu rutinitas bot Casama-mu sekarang. Hasilnya tiba di aplikasi dan sebagai notifikasi, seperti saat rutinitas berjalan sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue subito una delle routine dei tuoi bot Casama. Il risultato arriva nell’app e come notifica, come quando la routine parte da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casamaボットのルーティンを今すぐ実行します。自動で実行されたときと同様に、結果はアプリ内と通知で届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama 봇의 루틴 중 하나를 지금 실행해요. 루틴이 혼자 실행될 때와 마찬가지로 결과는 앱과 알림으로 도착해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa agora uma rotina dos seus bots do Casama. O resultado chega no app e como notificação, como quando a rotina roda sozinha."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama botlarınızın rutinlerinden birini şimdi çalıştırır. Sonuç, rutin kendiliğinden çalıştığında olduğu gibi uygulamaya ve bildirim olarak gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy ngay một quy trình của các bot Casama. Kết quả sẽ hiện trong ứng dụng và gửi qua thông báo giống như khi quy trình tự chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即运行你的 Casama 机器人的一个例行任务。结果会发送到应用内并通过通知提醒，与定时自动运行时一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即執行你的其中一個 Casama 機器人的例行任務。結果會傳送至應用程式內並發送通知，與自動排程執行時相同。"
          }
        }
      }
    },
