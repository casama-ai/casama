          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계 위에서 가장 중요한 한 가지를 한눈에 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o que mais importa, acima do relógio."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En önemli tek şeyi saatin üzerinde görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem một việc quan trọng nhất ngay phía trên đồng hồ."
