        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看哪些機器人正在等待你的回應，並快速回覆簡單請求。"
          }
        }
      }
    },
    "widgetIosRoutinesDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Routines, iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, was als Nächstes läuft, und führe eine Routine sofort aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what runs next, and run a routine now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
