    "widgetIosNeedsYouDescription" : {
      "comment" : "Widget gallery: what the widget does, shown when adding it; starts with a verb. Needs you, iPhone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, welche Bots auf dich warten, und beantworte einfache Anfragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See which bots are waiting on you, and answer the simple ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira qué bots te están esperando y responde las solicitudes simples."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
