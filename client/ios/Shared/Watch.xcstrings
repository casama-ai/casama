    "watchHoldHint" : {
      "comment" : "Shown on the watch app (D-410). VoiceOver/TalkBack hint replacing the hold.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben? Zum Erlauben doppelt tippen."
