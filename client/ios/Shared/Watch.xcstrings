        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow this? Double tap to allow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir esto? Toca dos veces para permitir."
          }
