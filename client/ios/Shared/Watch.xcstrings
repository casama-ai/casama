        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용할까요? 허용하려면 두 번 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir isto? Toque duas vezes para permitir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verilsin mi? İzin vermek için çift dokunun."
