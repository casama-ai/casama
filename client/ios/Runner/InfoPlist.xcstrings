{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "comment" : "System permission prompt on iPhone and iPad: why Casama asks. Alarms and timers.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bots können Wecker und Timer stellen, die auch im Stummmodus klingeln – nur wenn du Wecker unter Geräteverbindungen erlaubst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bots can set alarms and timers that ring through silent mode, only when you allow Alarms in Device connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bots pueden configurar alarmas y temporizadores que suenan incluso en modo silencio, pero solo si permites Alarmas en Conexiones del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos bots peuvent programmer des alarmes et minuteurs qui sonnent même en mode silencieux, uniquement lorsque vous autorisez Alarmes dans Connexions de l'appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botmu dapat menyetel alarm dan timer yang berbunyi meski dalam mode hening, hanya saat kamu mengizinkan Alarm di Koneksi perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi bot possono impostare sveglie e timer che suonano anche in modalità silenziosa, solo quando consenti Sveglie in Connessioni del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デバイス接続」で「アラーム」を許可した場合のみ、ボットが消音モードでも鳴るアラームやタイマーを設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 연결에서 알람을 허용한 경우에만 봇이 무음 모드에서도 울리는 알람과 타이머를 설정할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus bots podem definir alarmes e timers que tocam mesmo no modo silencioso, somente quando você permitir Alarmes em Conexões de dispositivos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlarınız yalnızca Cihaz bağlantıları bölümünde Alarmlar'a izin verdiğinizde sessiz modda bile çalan alarmlar ve zamanlayıcılar kurabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot chỉ đặt được báo thức và hẹn giờ đổ chuông cả ở chế độ im lặng khi bạn cho phép Báo thức trong Kết nối thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你在“设备连接”中允许“闹钟”时，你的机器人才可以设置在静音模式下仍会响铃的闹钟和计时器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當你在「裝置連線」中允許「鬧鐘」時，你的機器人才能設定在靜音模式下仍會響鈴的鬧鐘與計時器。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "System permission prompt on iPhone and iPad: why Casama asks. Calendar.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bots können Fragen zu deinen Terminen beantworten und Ereignisse hinzufügen – nur wenn du Kalender unter Geräteverbindungen aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bots can answer questions about your schedule and add events, only when you turn on Calendar in Device connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bots pueden responder preguntas sobre tu agenda y agregar eventos, solo cuando activas Calendario en Conexiones del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos bots peuvent répondre aux questions sur votre emploi du temps et ajouter des événements, uniquement lorsque vous activez Calendrier dans Connexions de l'appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botmu dapat menjawab pertanyaan tentang jadwalmu dan menambahkan acara, hanya saat kamu mengaktifkan Kalender di Koneksi perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi bot possono rispondere a domande sui tuoi impegni e aggiungere eventi, solo quando attivi Calendario in Connessioni del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デバイス接続」で「カレンダー」をオンにした場合のみ、ボットが予定に関する質問に答えたり予定を追加したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 연결에서 캘린더를 켠 경우에만 봇이 일정 질문에 답하고 이벤트를 추가할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus bots podem responder perguntas sobre sua agenda e adicionar eventos, somente quando você ativar Calendário em Conexões de dispositivos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlarınız programınızla ilgili soruları yanıtlayabilir ve etkinlik ekleyebilir; bunu yalnızca Cihaz bağlantıları bölümünde Takvim'i açtığınızda yapar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot của bạn chỉ có thể trả lời câu hỏi về lịch trình và thêm sự kiện khi bạn bật Lịch trong Kết nối thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你在“设备连接”中开启“日历”时，你的机器人才可以回答有关你日程的问题并添加日程事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當你在「裝置連線」中開啟「行事曆」時，你的機器人才能回答日程問題並新增活動。"
          }
        }
      }
    },
