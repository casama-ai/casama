<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local/ad-hoc Xcode build entitlements for CasamaFileProvider: omits keychain-access-groups,
     which macOS only grants with a provisioning profile. Release packaging scripts sign with
     CasamaFileProvider.entitlements alongside the provisioning profile. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>V8V5US964Z.ai.casama.app</string>
	</array>
</dict>
</plist>
