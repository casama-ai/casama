{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "System permission prompt on the Mac: why Casama asks. Reading other apps' window titles. Quick ask is the app's small ask box.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schnellanfrage liest den Titel des vordersten Fensters und den aktuellen Tab deines Browsers – nur wenn du die Tastenkombination drückst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick ask reads the front window's title and your browser's current tab, only when you press the shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta rápida lee el título de la ventana frontal y la pestaña actual de tu navegador solo cuando presionas el atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande rapide lit le titre de la fenêtre active et l'onglet actuel de votre navigateur, uniquement lorsque vous appuyez sur le raccourci."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya cepat membaca judul jendela terdepan dan tab browsermu saat ini, hanya saat kamu menekan pintasannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domanda rapida legge il titolo della finestra in primo piano e la scheda corrente del browser, solo quando premi la scorciatoia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを押したときに限り、クイック質問が最前面ウィンドウのタイトルとブラウザーの現在のタブを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 눌렀을 때만 빠른 질문이 앞쪽 윈도우의 제목과 브라우저의 현재 탭을 읽어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Pergunta rápida lê o título da janela em primeiro plano e a aba atual do navegador, somente quando você pressiona o atalho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı sor, öndeki pencerenin başlığını ve tarayıcınızın geçerli sekmesini yalnızca klavye kestirmesine bastığınızda okur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi nhanh chỉ đọc tiêu đề cửa sổ phía trước và tab hiện tại của trình duyệt khi bạn nhấn phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你按下快捷键时，快速提问才会读取最前窗口的标题和浏览器当前标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你按下快速鍵時，快速提問才會讀取最前景視窗的標題與瀏覽器目前的分頁。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "System permission prompt on the Mac: why Casama asks. Contacts.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bots können Personen nachschlagen, die du kennst – nur wenn du Kontakte unter Geräteverbindungen aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bots can look up people you know, only when you turn on Contacts in Device connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus bots pueden buscar personas que conoces, solo cuando activas Contactos en Conexiones del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos bots peuvent rechercher des personnes que vous connaissez, uniquement lorsque vous activez Contacts dans Connexions de l'appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botmu dapat mencari orang yang kamu kenal, hanya saat kamu mengaktifkan Kontak di Koneksi perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi bot possono cercare le persone che conosci, solo quando attivi Contatti in Connessioni del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デバイス接続」で「連絡先」をオンにした場合のみ、ボットが知人を検索できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 연결에서 연락처를 켠 경우에만 봇이 지인을 찾아볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus bots podem consultar pessoas que você conhece, somente quando você ativar Contatos em Conexões de dispositivos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botlarınız, yalnızca Cihaz bağlantıları bölümünde Kişiler'i açtığınızda tanıdığınız kişilerin bilgilerine bakabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bot của bạn chỉ có thể tra cứu người quen của bạn khi bạn bật Danh bạ trong Kết nối thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你在“设备连接”中开启“通讯录”时，你的机器人才可以查找你认识的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有當你在「裝置連線」中開啟「聯絡人」時，你的機器人才能查詢你認識的人。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "System permission prompt on the Mac: why Casama asks. Microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama nutzt das Mikrofon für Diktate und Live-Anrufe mit deinen Bots. Erst nach deiner Zustimmung geht deine Stimme an KI-Anbieter, um dir zu antworten: Google Gemini für Anrufe, OpenAI für die Umwandlung von Diktaten in Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama uses the microphone for dictation and live calls with your bots. Only after you agree, your voice goes to AI providers to answer you: Google Gemini for calls, OpenAI to turn dictation into text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama usa el micrófono para dictado y llamadas en vivo con tus bots. Solo después de que aceptes, tu voz va a proveedores de IA para responderte: Google Gemini para llamadas, OpenAI para convertir el dictado en texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama utilise le micro pour la dictée et les appels en direct avec vos bots. Uniquement après votre accord, votre voix est envoyée aux fournisseurs d'IA pour vous répondre : Google Gemini pour les appels, OpenAI pour transcrire la dictée en texte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama menggunakan mikrofon untuk dikte dan panggilan langsung dengan botmu. Hanya setelah kamu setuju, suaramu dikirim ke penyedia AI untuk menjawabmu: Google Gemini untuk panggilan, OpenAI untuk mengubah dikte menjadi teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama usa il microfono per la dettatura e le chiamate dal vivo con i tuoi bot. Solo dopo il tuo consenso, la tua voce viene inviata a fornitori IA per risponderti: Google Gemini per le chiamate, OpenAI per trasformare la dettatura in testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力やボットとのライブ通話のためにCasamaがマイクを使用します。同意した場合にのみ、音声が回答のためにAIプロバイダー（通話はGoogle Gemini、音声入力のテキスト変換はOpenAI）へ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama는 봇과의 받아쓰기와 실시간 통화를 위해 마이크를 사용해요. 동의하신 후에만 음성이 AI 제공업체로 전송돼요(통화는 Google Gemini, 받아쓰기 텍스트 변환은 OpenAI)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Casama usa o microfone para ditado e chamadas ao vivo com seus bots. Só depois que você concordar, sua voz é enviada a provedores de IA para responder a você: Google Gemini nas chamadas e OpenAI para transformar ditado em texto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama mikrofonu dikte ve botlarınızla canlı sesli aramalar için kullanır. Sesiniz, yalnızca siz kabul ettikten sonra, size yanıt vermek üzere yapay zeka sağlayıcılarına gider: sesli aramalar için Google Gemini'ye, dikteyi metne dönüştürmek için OpenAI'a."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama dùng micrô cho đọc chính tả và gọi trực tiếp với bot. Chỉ sau khi bạn đồng ý, giọng nói mới được gửi tới các nhà cung cấp AI để phản hồi bạn: Google Gemini cho cuộc gọi, OpenAI để chuyển lời đọc chính tả thành văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama 使用麦克风进行听写以及与你的机器人进行实时语音通话。只有在你同意之后，你的语音才会发送给 AI 提供商以响应你：通话使用 Google Gemini，听写转文字使用 OpenAI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama 會使用麥克風進行語音聽寫及與機器人的即時語音通話。僅在你同意後，你的語音才會傳送給 AI 供應商以回應你：Google Gemini 用於語音通話，OpenAI 用於將語音轉為文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "System permission prompt on the Mac: why Casama asks. Speech recognition.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Diktierdienst von Casama nicht erreichbar ist, wandelt die Spracherkennung deines Geräts Gesprochenes in Text um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Casama's dictation service can't be reached, your device's own speech recognition turns what you say into text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando no se puede acceder al servicio de dictado de Casama, el reconocimiento de voz de tu dispositivo convierte lo que dices en texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le service de dictée de Casama est inaccessible, la reconnaissance vocale intégrée à votre Mac transforme vos paroles en texte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat layanan dikte Casama tidak dapat dijangkau, pengenalan suara bawaan perangkatmu mengubah ucapanmu menjadi teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il servizio di dettatura di Casama non è raggiungibile, il riconoscimento vocale del tuo dispositivo trasforma ciò che dici in testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casamaの音声入力サービスに接続できないとき、デバイス標準の音声認識で話した内容をテキストに変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama 받아쓰기 서비스에 연결할 수 없을 때 기기 자체 음성 인식으로 말한 내용을 텍스트로 변환해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o serviço de ditado do Casama não estiver acessível, o reconhecimento de voz do próprio dispositivo transforma o que você fala em texto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casama'nın dikte hizmetine ulaşılamadığında cihazınızın kendi konuşma tanıma özelliği söylediklerinizi metne dönüştürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không kết nối được dịch vụ đọc chính tả của Casama, tính năng nhận dạng giọng nói ngay trên thiết bị sẽ chuyển lời nói của bạn thành văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当无法连接到 Casama 的听写服务时，将由你设备自身的语音识别功能把你说的话转换成文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當無法連線至 Casama 的語音聽寫服務時，裝置內建的語音辨識功能會將你的語音轉換為文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
