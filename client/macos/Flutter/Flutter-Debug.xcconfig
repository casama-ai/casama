#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "ephemeral/Flutter-Generated.xcconfig"
// The in-app browser is always compiled into Mac builds (D-632): the Mac App Store build and the
// direct DMG alike. scripts/app-browser-switch.sh no longer switches macOS.
OTHER_SWIFT_FLAGS = $(inherited) -D CASAMA_APP_BROWSER
